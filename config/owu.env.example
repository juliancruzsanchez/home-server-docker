# Optional OpenWebUI overrides.
#
# The main .env file at the repository root is what the stack actually reads.
# This file exists for anything OpenWebUI-specific you want to override
# without touching the shared .env.
#
# Copy this file to config/owu.env and uncomment what you need:
#     cp config/owu.env.example config/owu.env
#
# The stack starts fine without it.

# Leave empty to use the defaults baked into the compose file.
# WEBUI_URL=https://ai.home.example.com

# Ollama connection (defaults to the bundled Ollama in the same container)
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Set to true to require an email address before allowing a new signup.
# ENABLE_SIGNUP=false

# Personalisation
# WEBUI_NAME=My Home Server
# WEBUI_TAGLINE=Running on my own hardware

# Default model shown in the UI
# DEFAULT_MODELS=qwen3:14b
