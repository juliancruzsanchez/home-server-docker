# ============================================================================
#  home-server-docker — environment template
# ============================================================================
#  Copy to .env and fill in every value:
#      cp .env.example .env
#
#  .env is git-ignored. It holds real credentials — never commit it, never
#  paste its contents into an issue or a chat.
#
#  Generate the random secrets with:
#      ./scripts/generateKeys.sh
#  (it appends AUTHENTIK_SECRET_KEY, HASH_SALT and UNAMI_APP_SECRET to .env)
# ============================================================================


# --- Core --------------------------------------------------------------------
# Root domain every service is published under. Needs a public A record
# pointing at the server's IP (or a split-horizon DNS entry).
ROOT_DOMAIN=home.example.com

# Friendly name shown by OpenWebUI and Authentik.
SERVER_NAME_FRIENDLY=My Home Server

# Email address Caddy uses for ACME / Let's Encrypt registration.
EMAIL=you@example.com

# Absolute path where service data is written.
#
# IMPORTANT: keep the trailing slash. The stack mixes "${DATA_DIR}name" and
# "${DATA_DIR}/name" styles across service files; a trailing slash makes both
# resolve to the same path.
#
# Recommended layout (see docs/HOST-SETUP.md):
#   /mnt/fast/data/   -> SSD, for app state (databases, config, Git repos)
#   /mnt/raid/        -> RAID1, for media and model files
DATA_DIR=/mnt/fast/data/


# --- Shared database credentials ----------------------------------------------
# Reused by Nextcloud (MySQL), Immich (Postgres), Umami (Postgres) and GitLab.
# Generate a strong one: openssl rand -base64 32 | tr -d '\n'
DB_USER=home
DB_PASS=CHANGE_ME_generate_a_long_random_password


# --- Admin login --------------------------------------------------------------
# Nextcloud admin, Sonarr / Radarr / Lidarr, Wallos.
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_generate_a_long_random_password


# --- Authentik -----------------------------------------------------------------
# Generate with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# Pin the image tag if you want reproducible upgrades.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2025.6.1


# --- GitLab + Authentik SSO ------------------------------------------------------
# Create an OpenID Connect provider in Authentik for the GitLab application,
# then paste its client id and secret here.
GL_AUTHENTIK_ID=
GL_AUTHENTIK_SECRET=


# --- Vaultwarden -----------------------------------------------------------------
# Generate with: openssl rand -base64 24
BW_INSTALLATION_ID=
BW_INSTALLATION_KEY=


# --- Umami -------------------------------------------------------------------------
# Generate with: openssl rand 30 | openssl base64 -A | tr -d '\n'
UMAMI_APP_SECRET=
HASH_SALT=


# --- Immich --------------------------------------------------------------------------
# Pin a release tag if you do not want to track the rolling "release" channel.
IMMICH_VERSION=release


# --- Samba (SMB share) ---------------------------------------------------------------
# The share name and login for the SMB volume.
#
# IMPORTANT: the password that used to be hardcoded in services/samba.yml is
# public in this repository's git history. It MUST be rotated — set a new,
# unrelated value here.
SAMBA_SHARE_NAME=Games
SAMBA_USER=
SAMBA_PASS=


# --- Automatic1111 / Stable Diffusion ---------------------------------------------------
# Credentials for the Gradio UI. Injected into the container at runtime so they
# never end up baked into an image layer.
SD_USER=
SD_PASS=


# --- Mail (Nextcloud + Vaultwarden) -----------------------------------------------------
# The Nextcloud and Vaultwarden containers load .env directly, so any SMTP_*
# key placed here is passed through to the container.
#
# Generate with: openssl rand -base64 24
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASS=
SMTP_FROM_ADDRESS=no-reply@home.example.com
SMTP_SECURE=tls


# --- AdGuard (optional) -------------------------------------------------------------------
# Only used if you uncomment the DNS port mappings in services/adguard.yml.
DNS_PORT=53
