dns.{$ROOT_DOMAIN} {
	handle /dns-query {
		reverse_proxy https://adguardhome:443 {
			trusted_proxies 172.18.0.0/16
			header_up Host {upstream_hostport}
			header_up X-Real-IP 1.2.3.4
			transport http {
				tls
				tls_server_name dns.{$ROOT_DOMAIN}
			}
		}
	}

	handle /dns-query/* {
		reverse_proxy https://adguardhome:443 {
			trusted_proxies 172.18.0.0/16
			header_up Host {upstream_hostport}
			transport http {
				tls
				tls_server_name dns.{$ROOT_DOMAIN}
			}
		}
	}
reverse_proxy adguardhome	
}

